# Secrets
.env
# Backups of .env carry the same real keys — never commit them. (.env.example does
# not match these patterns and stays tracked on purpose.)
.env.bak
.env.bak.*
.env.local

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Test / lint tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state (professionalization work)
data/cost_ledger.jsonl
data/audit.sqlite3
data/audit.sqlite3-wal
data/audit.sqlite3-shm
data/cmms_outbox.jsonl
data/qa_cache/

# Generated data (regenerate via download_manuals.py + notebooks 01-02)
data/manuals/
data/vectorstore/

# Chunking-ablation stores (regenerate via notebooks/11_retrieval_benchmark.ipynb).
# Several hundred MB each, and rebuildable in ~3 min — never commit these.
data/vectorstore_cs*/

# Generated data (regenerate via download_defect_images.py + notebook 06)
data/defect_images/
data/vision_model/

# OS
.DS_Store

# Office lock files (created while a .pptx/.docx is open, deleted on close)
~$*

# Logs — app_out.log / app_err.log are the Streamlit run logs; they were tracked by
# mistake until 2026-09-03 and carry nothing but local run noise.
streamlit.log
*.log

# Local editor / agent settings — machine-specific, not project configuration.
.claude/settings.local.json
