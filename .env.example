# Copy this file to .env and fill in your key.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------------
# Optional FACTORY_FLOOR_* knobs. Every one has a safe default equal to the current
# behaviour — leave them unset for the classic experience. See factory_floor/config.py
# (the Settings dataclass) for the authoritative list.
# ---------------------------------------------------------------------------------

# Models
# FACTORY_FLOOR_LLM_MODEL=gpt-4.1-mini
# FACTORY_FLOOR_LLM_TEMPERATURE=0.0
# FACTORY_FLOOR_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval / tracing
# FACTORY_FLOOR_COLLECTION_NAME=factory_floor_manuals
# FACTORY_FLOOR_LANGSMITH_PROJECT=factory-floor

# Secrets source: "env" (default) reads this file / the environment. Other values
# (aws | vault | doppler | sops) are design-only seams — see docs/secrets.md.
# FACTORY_FLOOR_SECRETS_BACKEND=env

# Cost control (phase 3) — leave the cap unset to disable it entirely.
# FACTORY_FLOOR_DAILY_SPEND_CAP_USD=5.00
# FACTORY_FLOOR_COST_ALERT_THRESHOLD=0.8

# Blocking safety gate (phase 4): off | rewrite (default) | block
# FACTORY_FLOOR_SAFETY_GATE_MODE=rewrite
# FACTORY_FLOOR_SAFETY_GATE_ON_STREAM=buffer

# Semantic cache (phase 6) — opt-in.
# FACTORY_FLOOR_SEMANTIC_CACHE_ENABLED=false
# FACTORY_FLOOR_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
# FACTORY_FLOOR_SEMANTIC_CACHE_TTL_HOURS=720

# Audit trail + operator identity (phase 5)
# FACTORY_FLOOR_AUDIT_ENABLED=true
# FACTORY_FLOOR_REQUIRE_LOGIN=false
# FACTORY_FLOOR_AUDIT_DB_PATH=data/audit.sqlite3
# FACTORY_FLOOR_CMMS_OUTBOX_PATH=data/cmms_outbox.jsonl

# Multi-tenant (phase 7) — single tenant until a deployment needs otherwise.
# FACTORY_FLOOR_TENANT_ID=default
